{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trust-layer.local/v0.3/submit-local-verification.input.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_schema_version", "research_id", "verification_mode", "rubric_version", "checked_source_refs", "result", "result_codes", "alternative_source_refs", "client_verifier_version"],
  "properties": {
    "attestation_schema_version": { "const": "0.1" },
    "research_id": { "$ref": "https://schemas.trust-layer.local/v0.3/common-defs.json#/$defs/research_id_v4" },
    "verification_mode": { "const": "local_byo_api" },
    "rubric_version": { "const": "0.3" },
    "checked_source_refs": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "https://schemas.trust-layer.local/v0.3/common-defs.json#/$defs/source_ref" } },
    "result": { "enum": ["consistent", "inconsistent", "inconclusive"] },
    "result_codes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["primary_source_found", "primary_source_missing", "source_unavailable", "conflict_detected", "no_material_conflict", "scope_indeterminate"] } },
    "alternative_source_refs": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "https://schemas.trust-layer.local/v0.3/common-defs.json#/$defs/source_ref" } },
    "client_verifier_version": { "const": "0.1" }
  }
}
