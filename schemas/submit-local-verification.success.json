{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trust-layer.local/v0.3/submit-local-verification.success.json",
  "type": "object", "additionalProperties": false,
  "required": ["ok", "code", "attestation_id", "verification_effect"],
  "properties": { "ok": { "const": true }, "code": { "enum": ["accepted", "accepted_idempotent"] }, "attestation_id": { "type": "string", "pattern": "^v_[A-Za-z0-9_-]{16,64}$" }, "verification_effect": { "enum": ["self_report_recorded", "self_report_recorded_no_weight"] } }
}
